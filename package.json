{
  "name": "ticket-request-form",
  "version": "1.3.2",
  "private": true,
  "description": "Форма заявки на билет для членов фан-клуба Fondo Ruso",
  "type": "module",
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build && node prerender.js",
    "postinstall": "quasar prepare",
    "lint:ox": "oxlint --max-warnings 0",
    "lint:es": "eslint --max-warnings 0 --cache",
    "check": "run-p --continue-on-error check:*",
    "check:code": "run-p --continue-on-error lint:*",
    "check:format": "oxfmt --check",
    "fix": "run-s fix:*",
    "fix:code": "run-s \"lint:ox --fix\" \"lint:es --fix\"",
    "fix:format": "oxfmt --write"
  },
  "dependencies": {
    "@openpanel/web": "^1.4.1",
    "@quasar/extras": "^2.0.4",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "quasar": "^2.25.1",
    "vue": "^3.5.42",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@govnotech/conventions": "^0.1.1",
    "@quasar/app-vite": "^2.6.2",
    "@types/node": "^24.13.3",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.1",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.26",
    "puppeteer": "^25.9.0",
    "typescript": "~5.9.0",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=24.15"
  },
  "packageManager": "pnpm@10.28.2",
  "productName": "Заявка на билет"
}
